pipeline {
    agent any

    stages {
        stage('git pull') {
            steps {
                git branch: 'main', url: 'https://github.com/aktechpoint/jenkins_terraform_automation.git'
            }
        }
        stage('terraform init') {
            steps {
                sh 'terraform init'
            }
        }
        stage('terraform plan') {
            steps {
                sh 'terraform plan'
            }
        }
        stage('terraform ${action}') {
            steps {
                sh 'terraform ${action} --auto-approve'
            }
        }
    }
}
